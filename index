<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Viora — Crafted for Presence</title>
<meta name="description" content="Viora Perfumes — fragrance that speaks.">
<link rel="icon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     EDIT ME — brand colours. Change these six values to re-theme
     the whole page without touching anything else below.
     ============================================================ */
  :root{
    --cream:   #FFF8F4;   /* page background, top */
    --blush:   #F6E2E9;   /* page background, bottom / panels */
    --wine:    #7A1F3D;   /* headings, script accent */
    --rose:    #C0577A;   /* mid pink, links */
    --ink:     #35202A;   /* body text */
    --gold:    #B08A47;   /* hairlines, cap accent */

    --script: 'Alex Brush', cursive;
    --serif:  'Cormorant Garamond', Georgia, serif;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }

  body{
    margin:0;
    min-height:100vh;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream) 40%, var(--blush) 100%);
    font-family: var(--serif);
    color: var(--ink);
    display:flex;
    justify-content:center;
    -webkit-font-smoothing: antialiased;
  }

  a{ color: inherit; }

  .page{
    position: relative;
    width: 100%;
    max-width: 480px;
    padding: 56px 28px 40px;
    overflow: hidden;
  }

  /* ---------- falling petals (decorative, behind content) ---------- */
  #petal-field{
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .petal{
    position: absolute;
    top: -8%;
    width: 14px;
    height: 18px;
    opacity: .55;
    animation-name: fall, sway;
    animation-timing-function: linear, ease-in-out;
    animation-iteration-count: infinite, infinite;
    will-change: transform;
  }
  .petal svg{ width:100%; height:100%; display:block; }
  @keyframes fall{
    from{ transform: translateY(-10vh) rotate(0deg); }
    to{   transform: translateY(115vh) rotate(340deg); }
  }
  @keyframes sway{
    0%, 100%{ margin-left: 0px; }
    50%{ margin-left: 32px; }
  }
  @media (prefers-reduced-motion: reduce){
    .petal{ animation: none; opacity:.35; }
  }

  /* ---------- shared layout bits ---------- */
  .content{ position: relative; z-index: 1; }

  .flourish{
    display:block;
    width: 120px;
    height: 14px;
    margin: 14px auto 0;
    opacity: .8;
  }
  .flourish path{ stroke: var(--gold); }

  /* ---------- header ---------- */
  header{ text-align:center; margin-bottom: 40px; }

  .logo-img{
    width: 220px;
    max-width: 70%;
    height: auto;
    margin: 0 auto;
    display: block;
  }

  /* ---------- hero ---------- */
  .hero{ text-align:center; margin: 44px 0 40px; }
  .hero h1{
    font-family: var(--script);
    font-weight: 400;
    font-size: 3.1rem;
    line-height: 1;
    margin: 0;
    color: var(--wine);
  }
  .hero p{
    font-size: 1.15rem;
    font-weight: 500;
    margin: 6px 0 16px;
  }
  .hero .blurb{
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink);
    max-width: 34ch;
    margin: 0 auto;
  }

  /* ---------- product panel ---------- */
  #products{ margin: 8px 0 44px; }

  .product{
    border: 1px solid rgba(176,138,71,.5);
    border-radius: 2px 18px 2px 18px;
    padding: 22px 22px 24px;
    margin-bottom: 18px;
    background: rgba(255,255,255,.5);
  }
  .product .row{
    display:flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .product h3{
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.4rem;
    margin: 0;
    color: var(--wine);
  }
  .product .size{
    font-size: .92rem;
    color: var(--rose);
    white-space: nowrap;
  }
  .product .desc{
    margin: 8px 0 14px;
    font-size: 1rem;
    line-height: 1.5;
  }
  .product .price{
    font-family: var(--script);
    font-size: 1.7rem;
    color: var(--wine);
  }
  .product .buy{
    display:inline-block;
    margin-top: 12px;
    width: 100%;
    text-align:center;
    padding: 12px 18px;
    background: var(--wine);
    color: var(--cream);
    text-decoration: none;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    border-radius: 2px 14px 2px 14px;
    transition: background .2s ease;
  }
  .product .buy:hover{ background: #5f1730; }

  /* ---------- notes ---------- */
  #notes{ margin-bottom: 44px; }
  #notes h2{
    text-align:center;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.5rem;
    color: var(--wine);
    margin: 0 0 20px;
  }
  .note-row{
    display:flex;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(176,138,71,.3);
  }
  .note-row:last-child{ border-bottom:none; }
  .note-row .label{
    flex: 0 0 88px;
    font-size: .88rem;
    letter-spacing: .03em;
    color: var(--rose);
    padding-top: 2px;
  }
  .note-row .value{
    flex:1;
    font-size: 1.02rem;
  }

  /* ---------- links / socials ---------- */
  #links{ margin-bottom: 40px; }
  .link-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap: 8px;
    padding: 13px 18px;
    margin-bottom: 12px;
    border: 1px solid var(--wine);
    border-radius: 999px;
    text-decoration:none;
    font-size: 1rem;
    color: var(--wine);
    transition: background .2s ease, color .2s ease;
  }
  .link-btn:hover{ background: var(--wine); color: var(--cream); }

  footer{
    text-align:center;
    font-size: .85rem;
    color: var(--rose);
    opacity: .85;
    margin-top: 20px;
  }
</style>
</head>
<body>

<div id="petal-field"></div>

<div class="page">
  <div class="content">

    <header>
      <!-- EDIT ME — swap this data URI for your own logo file/link if you update it later -->
      <img class="logo-img" src="data:image/png;base64," alt="Viora — Crafted for Presence">
      <svg class="flourish" viewBox="0 0 120 14" aria-hidden="true">
        <path d="M2 8 Q20 2, 38 8 T74 8" fill="none" stroke-width="1.4" stroke-linecap="round"/>
        <path d="M46 11 Q64 4, 82 10 T118 6" fill="none" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </header>

    <section class="hero">
      <h1>Fragrance</h1>
      <p>that speaks</p>
      <p class="blurb">
        Crafted with the finest notes to capture your essence
        and leave an unforgettable trail.
      </p>
    </section>

    <!-- ============================================================
         EDIT ME — add or change products here. Each object becomes
         one product panel below, in order.
         ============================================================ -->
    <section id="products"></section>
    <script id="product-data" type="application/json">
    [
      {
        "name": "Rose Noir",
        "size": "10 ml roll-on",
        "desc": "A velvet bouquet of rose petals over warm amber and musk.",
        "price": "Rs. 1,560",
        "buyLabel": "Order on WhatsApp",
        "buyUrl": "https://wa.me/94719478895?text=Hi%20Viora%2C%20I%27d%20love%20to%20order%20Rose%20Noir"
      }
    ]
    </script>

    <section id="notes">
      <h2>The notes</h2>
      <div class="note-row"><div class="label">Top</div><div class="value">Bulgarian rose, pink pepper</div></div>
      <div class="note-row"><div class="label">Heart</div><div class="value">Peony, lychee, white musk</div></div>
      <div class="note-row"><div class="label">Base</div><div class="value">Amber, soft woods, vanilla</div></div>
    </section>

    <!-- ============================================================
         EDIT ME — add or change social / contact links here.
         ============================================================ -->
    <section id="links"></section>
    <script id="link-data" type="application/json">
    [
      { "label": "Instagram — @ceylon.viora", "url": "https://www.instagram.com/ceylon.viora/" },
      { "label": "Facebook — Ceylon.Viora", "url": "https://web.facebook.com/profile.php?id=61593945023767" },
      { "label": "TikTok — @ceylon_viora", "url": "https://www.tiktok.com/@ceylon_viora" },
      { "label": "Message us on WhatsApp", "url": "https://wa.me/94719478895" }
    ]
    </script>

    <footer>Viora — Ceylon &nbsp;·&nbsp; © 2026</footer>

  </div>
</div>

<script>
  // Render products
  (function(){
    var data = JSON.parse(document.getElementById('product-data').textContent);
    var el = document.getElementById('products');
    data.forEach(function(p){
      var div = document.createElement('div');
      div.className = 'product';
      div.innerHTML =
        '<div class="row"><h3>' + p.name + '</h3><span class="size">' + p.size + '</span></div>' +
        '<p class="desc">' + p.desc + '</p>' +
        '<div class="price">' + p.price + '</div>' +
        '<a class="buy" href="' + p.buyUrl + '" target="_blank" rel="noopener">' + p.buyLabel + '</a>';
      el.appendChild(div);
    });
  })();

  // Render links
  (function(){
    var data = JSON.parse(document.getElementById('link-data').textContent);
    var el = document.getElementById('links');
    data.forEach(function(l){
      var a = document.createElement('a');
      a.className = 'link-btn';
      a.href = l.url;
      a.target = '_blank';
      a.rel = 'noopener';
      a.textContent = l.label;
      el.appendChild(a);
    });
  })();

  // Falling rose petals
  (function(){
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var field = document.getElementById('petal-field');
    var count = reduce ? 5 : 11;
    var petalSVG = '<svg viewBox="0 0 20 26"><path d="M10 0 C17 6, 17 20, 10 26 C3 20, 3 6, 10 0 Z" fill="#C0577A"/></svg>';

    for (var i = 0; i < count; i++){
      var p = document.createElement('div');
      p.className = 'petal';
      p.innerHTML = petalSVG;

      var size = 10 + Math.random() * 12;
      var left = Math.random() * 100;
      var fallDur = 14 + Math.random() * 10;
      var swayDur = 3 + Math.random() * 3;
      var delay = Math.random() * -20;

      p.style.left = left + 'vw';
      p.style.width = size + 'px';
      p.style.height = (size * 1.3) + 'px';
      p.style.opacity = (0.35 + Math.random() * 0.35).toFixed(2);
      p.style.animationDuration = fallDur + 's, ' + swayDur + 's';
      p.style.animationDelay = delay + 's, ' + delay + 's';

      field.appendChild(p);
    }
  })();
</script>

</body>
</html>
